# TikZ and PGF completion definitions
\begin{tikzpicture}
\begin{scope}
\begin{matrix}
\begin{pgfonlayer}
\begin{pgfinterruptpath}
\begin{scope}
\begin{fit}
\begin{circuits.logic.US}
\draw[options] (coordinate) -- (coordinate);
\draw plot[options] coordinates {coordinates};
\path[options] (coordinate) -- (coordinate);
\path let \p{point} = (coordinate) in (coordinate);
\useasboundingbox (coordinate) rectangle (coordinate);
\node[options] (name) at (coordinate) {text};
\nodepart{part}
\coordinate (name) at (coordinate);
\matrix (name) [options] {cells};
\pic[options] (name) at (coordinate) {pic};
\graph[options] {graph};
\edge[options] (coordinate);
\to[options] (coordinate);
\foreach \variable in {list} {commands}
\foreach \variable \in {list} {commands}
\fill[options] (coordinate) -- (coordinate) -- cycle;
\filldraw[options] (coordinate) -- (coordinate) -- cycle;
\shade[options] (coordinate) rectangle (coordinate);
\shadedraw[options] (coordinate) rectangle (coordinate);
\pattern[options] (coordinate) rectangle (coordinate);
\clip[options] (coordinate) rectangle (coordinate);
\pgfextra{code}
\pgfinterruptpath{code}
\pgfonlayer{layer}
\pgfmathsetmacro{macro}{expression}
\pgfmathtruncatemacro{macro}{expression}
\pgfmathparse{expression}
\pgfkeys{/key=value}
\pgfkeysalso{/key=value}
\tikz
\tikzset{key/.style={options}}
\tikzstyle{name}=[options]
\usetikzlibrary{library}
\tikzexternalenable
\tikzexternaldisable
\tikzsetnextfilename{name}
\tikzmath{code}
\tikzmark{name}
\coordinate (name) at (intersection of coordinate--coordinate and coordinate--coordinate);
\draw[decorate,decoration={name=...}] (coordinate) -- (coordinate);
\draw (coordinate) to[bend left] (coordinate);
\draw (coordinate) edge[options] (coordinate);

