# Core LaTeX completion definitions
\begin{document}
\begin{itemize}
\begin{enumerate}
\begin{figure}
\begin{table}
\begin{equation}
\begin{align}
\documentclass{class}
\usepackage{package}
\usetikzlibrary{library}
\title{title}
\author{author}
\date{date}
\section{title}
\subsection{title}
\subsubsection{title}
\textbf{text}
\textit{text}
\emph{text}
\frac{numerator}{denominator}
\sqrt{expression}
\label{name}
\ref{name}
\pageref{name}
\cite{key}
\includegraphics[options]{file}
\caption{text}
\item
\centering
\newcommand{command}[arguments]{definition}
